# CRM (companies, jobs, employees, applications, employments): Supabase only — requires SUPABASE_* below.
# CRM_DATA_DIR= optional; used only for job-listing scrape JSON sidecar paths.

# Job listing scrape + AI ledger (default: <CRM_DATA_DIR>/../job-listing)
# JOB_LISTING_DATA_DIR=

# Optional: Anthropic — job import-listing extract + company website-research (At a glance) summary + User Background Studio coach chat
# ANTHROPIC_API_KEY=

# Required for User Background Studio (profiles, versions, coach chat stored in Supabase user_background_* tables).
# Also required for job listing AI ledger (job_listing_ai_* tables) and section bullets mirror.
# Also required for Cursor generation ledgers (cover_letter_generation_*, company_interest_generation_*, skills_component_generation_*) and Professional Background (professional_background table).
# Run the relevant SQL from docs/ (see docs/supabase-user-background-studio-schema.sql for UBS tables).
# Required for graphics, technical skills, job studio, etc.
# After setting these, run docs/supabase-image-graphics-schema.sql and docs/supabase-error-log-schema.sql in that project's SQL Editor.
# APP_SLUG=code-your-resume
# GIT_COMMIT_SHA=
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Cursor Cloud Agents API — skills component generation (POST /api/data/skills-component/generate).
# Get your API key from https://cursor.com/settings. The target repo must be authorized in Cursor's dashboard
# and the Cursor GitHub App must be installed on that org/repo.
# Use the Next.js app repo (the one with .cursor/architecture/), NOT this express-server repo.
# CURSOR_API_KEY=
# CURSOR_TARGET_REPO=Luckee-Core/code-your-resume-open-source
# Optional tuning for long-running Cursor agents (defaults shown):
# CURSOR_AGENT_MAX_WAIT_MS=1200000
# CURSOR_AGENT_POLL_INTERVAL_MS=15000

# Bind address. Local dev defaults to 127.0.0.1; production/Railway defaults to 0.0.0.0 automatically.
# HOST=0.0.0.0

# Email Manager — code-your-resume pulls fetched emails for AI job parsing
# EMAIL_MANAGER_EXPRESS_URL=http://localhost:3051

# Website scraper (Playwright) — job import-listing uses POST /api/scrape when set (JS/SPA pages)
# WEBSITE_SCRAPER_URL=http://localhost:3043

# LinkedIn profile scraper (Apify proxy) — POST /api/services/get-linkedin-profile-by-url
# LINKEDIN_SCRAPER_EXPRESS_URL=http://localhost:3039

# Optional shared secret: when set, `/api/data/*`, `/api/technical-skills/*`, and `/api/job-newsletter-ingest/*` require
# `X-CRM-API-Key: <value>` or `Authorization: Bearer <value>`. Set the same value as Next.js `CRM_API_SECRET`.
# CRM_API_SECRET=

# Comma-separated CORS origins for browser → Express (not needed when using Next rewrites only).
# In production, CORS_ORIGINS=* is ignored (unsafe); use an explicit list.
# CORS_ORIGINS=http://localhost:3000

# PORT=3053
